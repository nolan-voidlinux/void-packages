# Template file for 'nvidia-nf'

_desc="NVIDIA new feature drivers for linux Meta Package"

pkgname=linux-mainline
MAJOR=595
MINOR=91.07
version=${MAJOR}.${MINOR}
revision=1
metapackage=yes
maintainer="Nolan MacPhee <nolan.voidlinux@gmail.com>"
license="custom:NVIDIA Proprietary"
homepage="https://www.nvidia.com/en-us/drivers/unix/"

archs="x86_64"
repository="nonfree"
short_desc="${_desc} - Libraries and Utilities"
conflicts="nvidia-stable>=0"
replaces="nvidia-stable>=0"

subpackages="nvidia-nf-gtklibs nvidia-nf-dkms nvidia-nf-firmware nvidia-nf-opencl nvidia-nf-libs nvidia-nf-libs-32bit"
depends="nvidia${MAJOR}
 nvidia-nf-gtklibs-${version}_${revision}
 nvidia-nf-dkms-${version}_${revision}
 nvidia-nf-firmare-${version}_${revision}"

nvidia-nf-gtklibs_package() {
        short_desc="${_desc} - GTK+ libraries Meta Package"
        conflicts="nvidia-stable-gtklibs>=0"
	replaces="nvidia-stable-gtklibs>=0"
	depends="nvidia${MAJOR}-gtklibs"
	metapackage=yes
}

nvidia-nf-libs-32bit_package() {
        short_desc="${_desc} - common libraries (32bit) Meta Package"
        conflicts="nvidia-stable-libs-32bit>=0"
	replaces="nvidia-stable-libs-32bit>=0"
        repository="multilib/nonfree"
        depends="nvidia${MAJOR}-libs-32bit"
	metapackage=yes
}

nvidia-nf-libs_package() {
        short_desc="${_desc} - common libraries Meta Package"
        conflicts="nvidia-stable-libs>=0"
	replaces="nvidia-stable-libs>=0"
	depends="nvidia${MAJOR}-libs"
	metapackage=yes
}

nvidia-nf-dkms_package() {
        short_desc="${_desc} - DKMS kernel module Meta Package"
        conflicts="nvidia-stable-dkms>=0"
	replaces="nvidia-stable-dkms>=0"
	depends="nvidia${MAJOR}-dkms"
        license="MIT AND GPL-2.0-only"
	metapackage=yes
}

nvidia-nf-opencl_package() {
        short_desc="${_desc} - OpenCL implementation Meta Package"
        conflicts="nvidia-stable-opencl>=0"
	replaces="nvidia-stable-opencl>=0"
	depends="nvidia${MAJOR}-opencl"
	metapackage=yes
}

nvidia-nf-firmware_package() {
        short_desc="${_desc} - Firmware Meta Package"
	depends="nvidia${MAJOR}-firmware"
	metapackage=yes
}
